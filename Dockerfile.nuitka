# syntax=docker/dockerfile:1
#
# Nuitka-compiled API server. Application code is compiled in the builder stage;
# heavy ML wheels (torch, transformers, paddleocr, etc.) stay as runtime packages.
#
# Build:
#   docker build -f Dockerfile.nuitka -t ai-tutor-backend:nuitka .
#
# Run (with compose):
#   docker compose -f docker-compose.nuitka.yml up -d --build

# -----------------------------------------------------------------------------
# Stage 1: compile application with Nuitka
# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ccache \
    patchelf \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt requirements-ml-docker.txt ./
RUN pip install --upgrade pip \
    && pip install nuitka ordered-set zstandard \
    && pip install -r requirements-docker.txt \
    && pip install -r requirements-ml-docker.txt

COPY . .

RUN chmod +x scripts/nuitka_build.sh \
    && ./scripts/nuitka_build.sh

# -----------------------------------------------------------------------------
# Stage 2: lean runtime with compiled binary + ML wheels
# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PDF_EXTRACTION_MODELS_DIR=/app/models \
    PDF_EXTRACTION_PIPELINE_ENABLED=true \
    OCR_ENABLED=true \
    USE_MULTIMODAL_IMAGE_RETRIEVAL=true \
    WARM_MULTIMODAL_ON_STARTUP=true \
    ENABLE_VISUAL_INTENT_DETECTION=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libpq5 \
    libsm6 \
    libxext6 \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

# Reuse wheels built in the builder stage (avoids recompiling native deps like stringzilla).
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Nuitka standalone distribution (compiled app + launcher).
COPY --from=builder /build/nuitka-out/nuitka_launcher.dist /app/nuitka.dist

COPY configs/ Ultralytics/ ./
COPY docker-entrypoint-nuitka.sh docker-entrypoint.sh
RUN chmod +x docker-entrypoint.sh

RUN mkdir -p uploads chroma_db models/Layout/YOLO models/MFD/YOLO

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/health/ai-models || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
