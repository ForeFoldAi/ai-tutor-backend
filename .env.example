# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible). LLM_* wins when set; else MISTRAL_* below.
# ---------------------------------------------------------------------------
# Shared defaults
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Per-feature overrides (optional — empty = shared defaults / MISTRAL_*)
# chat
# LLM_CHAT_MODEL=
# LLM_CHAT_API_KEY=
# LLM_CHAT_BASE_URL=
# voice
# LLM_VOICE_MODEL=
# LLM_VOICE_API_KEY=
# LLM_VOICE_BASE_URL=
# lesson
# LLM_LESSON_MODEL=
# LLM_LESSON_API_KEY=
# LLM_LESSON_BASE_URL=
# assistant
# LLM_ASSISTANT_MODEL=
# LLM_ASSISTANT_API_KEY=
# LLM_ASSISTANT_BASE_URL=

# Legacy aliases (used if LLM_API_KEY / LLM_MODEL unset)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=1024

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_tutor
REDIS_URL=redis://localhost:6379/0
# Redis is for Celery + lesson planner (and optional voice learner profiles).
# Tutor answers / chat history are NOT stored in Redis.
# Full matrix: deploy/REDIS_CELERY.md
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brand name used in email subjects and templates
APP_NAME=AI Tutor

# SMTP (aiosmtplib). Leave SMTP_ENABLED=false for local no-op sends.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true
# Set false if STARTTLS fails with self-signed / MITM certs (local only)
SMTP_VALIDATE_CERTS=true
PASSWORD_OTP_EXPIRE_MINUTES=10
PASSWORD_OTP_LENGTH=6
PASSWORD_OTP_MAX_ATTEMPTS=5

# Daily reminder emails (IST)
MAIL_REMINDERS_ENABLED=true
MAIL_SESSION_REMINDER_HOUR=8
MAIL_ASSIGNMENT_REMINDER_HOUR=9
MAIL_REMINDER_MINUTE=0
MAIL_REMINDER_TZ=Asia/Kolkata
MAIL_REMINDER_SEND_GAP_SECONDS=1

# Spawn Celery worker + beat when uvicorn starts (needs Redis)
CELERY_AUTOSTART=true

# Learning Intelligence Agent (LIA) — observes students, coaches the AI Tutor
LIA_ENABLED=true
# Seed concept graph from catalog chapters on server startup
LIA_SEED_CONCEPT_GRAPH=true
# Set in production for /internal/lia/* routes (leave empty in local dev)
LIA_INTERNAL_TOKEN=
VITE_TEST_STUDENT_USERNAME=student
VITE_TEST_STUDENT_PASSWORD=password
VITE_TEST_TUTOR_USERNAME=tutor
VITE_TEST_TUTOR_PASSWORD=password
VITE_TEST_SCHOOL_ADMIN_USERNAME=admin
VITE_TEST_SCHOOL_ADMIN_PASSWORD=password
VITE_TEST_MASTER_ADMIN_USERNAME=master
VITE_TEST_MASTER_ADMIN_PASSWORD=password
VITE_TEST_ORG_ADMIN_USERNAME=organization
VITE_TEST_ORG_ADMIN_PASSWORD=password

# Premium TTS (ElevenLabs) — set the key to switch off free/unofficial edge-tts.
# Leave blank to keep using edge-tts. Voice ids default to public ElevenLabs
# premade voices (Rachel/Adam); override with your own cloned/chosen voices.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
# VOICE_TTS_PROVIDER=edge   # uncomment to force edge-tts even with a key set

# Edge TTS prosody (-2% = near-natural; was -6%)
VOICE_TTS_RATE=-2%
VOICE_TTS_PITCH=+0Hz

# Voice pipeline tuning (latency / continuity)
VOICE_TTS_PREFETCH=true
VOICE_IDLE_FLUSH_SEC=0.12
VOICE_IDLE_FLUSH_STEADY_SEC=0.22
VOICE_SPEECH_FIRST_WORDS=3
VOICE_SPEECH_FIRST_CHARS=14
VOICE_SPEECH_STEADY_WORDS=10
VOICE_SPEECH_STEADY_CHARS=48
VOICE_SPEECH_MAX_WORDS=16
VOICE_INTERRUPT_CANCEL_SEC=0.45
VOICE_SPEECH_QUEUE_MAXSIZE=6
VOICE_PROMPT_MAX_WORDS=75
VOICE_PROMPT_EXPAND_WORDS=100
VOICE_EMBEDDING_WARMUP=true
VOICE_RAG_PREWARM=true
VOICE_HTTP_TTS_PREFETCH=true
VOICE_RETRIEVAL_K=3
VOICE_CONTEXT_CHAR_BUDGET=6000

# Server Whisper STT (requires: pip install faster-whisper)
VOICE_WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice protection (ChatGPT-Voice-like barge-in gating)
VOICE_PROTECTION_ENABLED=true
VAD_ENABLED=true
VAD_THRESHOLD=0.75
MIN_SPEECH_MS=300
POST_PLAYBACK_STT_DELAY_MS=1200
ECHO_SIMILARITY_THRESHOLD=0.7
SPEAKER_VERIFICATION_ENABLED=true
SPEAKER_SIMILARITY_THRESHOLD=0.7
NOISE_SUPPRESSION_ENABLED=true
NOISE_SUPPRESSION_PROVIDER=rnnoise
INTERRUPT_SCORE_THRESHOLD=0.75
INTERRUPT_WEIGHT_VAD=0.4
INTERRUPT_WEIGHT_SPEAKER=0.4
INTERRUPT_WEIGHT_INTENT=0.2
VOICE_TTS_PREFETCH_DEPTH=2
VOICE_TTS_LOOKAHEAD_CHARS=24
VOICE_PROTECTION_PRELOAD=true
WAKE_WORD_ENABLED=false
# WAKE_WORDS=hey tutor,teacher

# Session-scoped voice profile (bootstrap from first question, auto-delete on session end)
VOICE_SESSION_PROFILE=true
VOICE_SESSION_PROFILE_MIN_MS=1200
VOICE_SESSION_TTL_SEC=14400
VOICE_SESSION_REDIS=true
VOICE_SSML_PROSODY=true

# Production: set ENVIRONMENT=production and strong JWT_SECRET_KEY (32+ chars)
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

CHUNK_OVERLAP_TOKENS=51
RETRIEVAL_K=5
CONTEXT_CHAR_BUDGET=14000
TOP_RELATED_IMAGES=4
MIN_IMAGE_RELEVANCE_SCORE=22
MIN_IMAGE_RELATIVE_TO_TOP=0.62
MIN_CLIP_IMAGE_SIMILARITY=0.18
MIN_PAGE_PROXIMITY_FALLBACK=10
EARLY_IMAGE_MIN_CHARS=100
IMAGE_RETRIEVAL_TIMEOUT_SEC=25

# Multimodal textbook figure search (CLIP + separate Chroma image index)
USE_MULTIMODAL_IMAGE_RETRIEVAL=true
MULTIMODAL_IMAGE_MODEL=openai/clip-vit-base-patch32
MULTIMODAL_RETRIEVAL_K=24
WARM_MULTIMODAL_ON_STARTUP=true
# Required to download CLIP from Hugging Face (create at https://huggingface.co/settings/tokens)
# Required for Docker full image (multimodal images + layout model download)
HF_TOKEN=

# Vision captions for figures with weak PDF/OCR metadata (BLIP via Transformers)
VISION_CAPTION_ENABLED=true
VISION_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# ---------------------------------------------------------------------------
# Object storage (default: s3 — MinIO / AWS / compatible). Use local for disk.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=ai-tutor
# MinIO / custom endpoint; leave empty for real AWS S3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Optional CDN prefix for public image URLs (preferred over short-lived presigns)
CDN_BASE_URL=
# Optional thumbnails, e.g. 320x240
IMAGE_THUMB_SIZE=

# ---------------------------------------------------------------------------
# Vector backend (default: qdrant). Use chroma for local chroma_db only.
# ---------------------------------------------------------------------------
VECTOR_BACKEND=qdrant
CHROMA_PATH=chroma_db
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Seconds for Qdrant HTTP client (collection auto-create + upsert)
QDRANT_TIMEOUT=60
