MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=1024

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_tutor
REDIS_URL=redis://localhost:6379/0
# Store repeated LLM tutor answers in Redis (default: false — always call the LLM)
TUTOR_ANSWER_CACHE_ENABLED=false
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VITE_TEST_STUDENT_USERNAME=student
VITE_TEST_STUDENT_PASSWORD=password
VITE_TEST_TUTOR_USERNAME=tutor
VITE_TEST_TUTOR_PASSWORD=password
VITE_TEST_SCHOOL_ADMIN_USERNAME=admin
VITE_TEST_SCHOOL_ADMIN_PASSWORD=password
VITE_TEST_MASTER_ADMIN_USERNAME=master
VITE_TEST_MASTER_ADMIN_PASSWORD=password
VITE_TEST_ORG_ADMIN_USERNAME=organization
VITE_TEST_ORG_ADMIN_PASSWORD=password

# Edge TTS prosody (-2% = near-natural; was -6%)
VOICE_TTS_RATE=-2%
VOICE_TTS_PITCH=+0Hz

# Voice pipeline tuning (latency / continuity)
VOICE_TTS_PREFETCH=true
VOICE_IDLE_FLUSH_SEC=0.12
VOICE_IDLE_FLUSH_STEADY_SEC=0.22
VOICE_SPEECH_FIRST_WORDS=3
VOICE_SPEECH_FIRST_CHARS=14
VOICE_SPEECH_STEADY_WORDS=10
VOICE_SPEECH_STEADY_CHARS=48
VOICE_SPEECH_MAX_WORDS=16
VOICE_INTERRUPT_CANCEL_SEC=0.45
VOICE_SPEECH_QUEUE_MAXSIZE=6
VOICE_PROMPT_MAX_WORDS=75
VOICE_PROMPT_EXPAND_WORDS=100
VOICE_EMBEDDING_WARMUP=true
VOICE_RAG_PREWARM=true
VOICE_HTTP_TTS_PREFETCH=true
VOICE_RETRIEVAL_K=3
VOICE_CONTEXT_CHAR_BUDGET=6000

# Server Whisper STT (requires: pip install faster-whisper)
VOICE_WHISPER_ENABLED=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice protection (ChatGPT-Voice-like barge-in gating)
VOICE_PROTECTION_ENABLED=true
VAD_ENABLED=true
VAD_THRESHOLD=0.75
MIN_SPEECH_MS=300
POST_PLAYBACK_STT_DELAY_MS=1200
ECHO_SIMILARITY_THRESHOLD=0.7
SPEAKER_VERIFICATION_ENABLED=true
SPEAKER_SIMILARITY_THRESHOLD=0.7
NOISE_SUPPRESSION_ENABLED=true
NOISE_SUPPRESSION_PROVIDER=rnnoise
INTERRUPT_SCORE_THRESHOLD=0.75
INTERRUPT_WEIGHT_VAD=0.4
INTERRUPT_WEIGHT_SPEAKER=0.4
INTERRUPT_WEIGHT_INTENT=0.2
VOICE_TTS_PREFETCH_DEPTH=2
VOICE_TTS_LOOKAHEAD_CHARS=24
VOICE_PROTECTION_PRELOAD=true
WAKE_WORD_ENABLED=false
# WAKE_WORDS=hey tutor,teacher

CHUNK_OVERLAP_TOKENS=51
RETRIEVAL_K=5
CONTEXT_CHAR_BUDGET=14000
TOP_RELATED_IMAGES=4
MIN_IMAGE_RELEVANCE_SCORE=22
MIN_IMAGE_RELATIVE_TO_TOP=0.62
MIN_CLIP_IMAGE_SIMILARITY=0.18
MIN_PAGE_PROXIMITY_FALLBACK=10
EARLY_IMAGE_MIN_CHARS=100
IMAGE_RETRIEVAL_TIMEOUT_SEC=25

# Multimodal textbook figure search (CLIP + separate Chroma image index)
USE_MULTIMODAL_IMAGE_RETRIEVAL=true
MULTIMODAL_IMAGE_MODEL=openai/clip-vit-base-patch32
MULTIMODAL_RETRIEVAL_K=24
WARM_MULTIMODAL_ON_STARTUP=true
# Required to download CLIP from Hugging Face (create at https://huggingface.co/settings/tokens)
# Required for Docker full image (multimodal images + layout model download)
HF_TOKEN=

# Vision captions for figures with weak PDF/OCR metadata (BLIP via Transformers)
VISION_CAPTION_ENABLED=true
VISION_CAPTION_MODEL=Salesforce/blip-image-captioning-base
