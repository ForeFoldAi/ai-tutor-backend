MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_TOKENS=1024

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_tutor
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VITE_TEST_STUDENT_USERNAME=student
VITE_TEST_STUDENT_PASSWORD=password
VITE_TEST_TUTOR_USERNAME=tutor
VITE_TEST_TUTOR_PASSWORD=password
VITE_TEST_SCHOOL_ADMIN_USERNAME=admin
VITE_TEST_SCHOOL_ADMIN_PASSWORD=password
VITE_TEST_MASTER_ADMIN_USERNAME=master
VITE_TEST_MASTER_ADMIN_PASSWORD=password
VITE_TEST_ORG_ADMIN_USERNAME=organization
VITE_TEST_ORG_ADMIN_PASSWORD=password

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=51
RETRIEVAL_K=5
CONTEXT_CHAR_BUDGET=14000
TOP_RELATED_IMAGES=4
MIN_IMAGE_RELEVANCE_SCORE=22
MIN_IMAGE_RELATIVE_TO_TOP=0.62
MIN_CLIP_IMAGE_SIMILARITY=0.18
MIN_PAGE_PROXIMITY_FALLBACK=10
EARLY_IMAGE_MIN_CHARS=100
IMAGE_RETRIEVAL_TIMEOUT_SEC=25

# Multimodal textbook figure search (CLIP + separate Chroma image index)
USE_MULTIMODAL_IMAGE_RETRIEVAL=true
MULTIMODAL_IMAGE_MODEL=openai/clip-vit-base-patch32
MULTIMODAL_RETRIEVAL_K=24
WARM_MULTIMODAL_ON_STARTUP=true
# Required to download CLIP from Hugging Face (create at https://huggingface.co/settings/tokens)
HF_TOKEN=
