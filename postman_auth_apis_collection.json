            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Tutor One\",\n  \"email\": \"tutor1@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"organization_id\": \"{{organization_id}}\",\n  \"school_id\": \"{{school_id}}\",\n  \"teaching_board\": \"CBSE\",\n  \"teaching_classes\": [\n    { \"grade\": \"6\", \"sections\": [\"A\", \"B\"] },\n    { \"grade\": \"7\", \"sections\": [\"A\"] },\n    { \"grade\": \"8\", \"sections\": [\"A\", \"B\", \"C\"] }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/create-tutor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "create-tutor"
              ]
            }
          }
        },
