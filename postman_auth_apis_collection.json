                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"NewStrongPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/verify-email?token={{verify_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{verify_token}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Protected APIs",
      "item": [
        {
          "name": "Create School Admin",
          "description": "New campus: send school_name (and optional branch/board). Add another admin to an existing school: send school_id instead of school_name.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"School Admin One\",\n  \"email\": \"schooladmin1@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"organization_id\": \"{{organization_id}}\",\n  \"school_name\": \"ABC School\",\n  \"branch\": \"North Campus\",\n  \"board\": \"CBSE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/create-school-admin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "admin",
                "create-school-admin"
              ]
            }
          }
        },
